<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET is intentionally NOT declared. The morning-summary WebView must never
      be able to load remote content, and the app has no other network features.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name=".MorningAlarmApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@drawable/ic_alarm"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_alarm"
        android:supportsRtl="true"
        android:theme="@style/Theme.MorningAlarm"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Owns alarm playback so it does not depend on the ring Activity existing.
          The mediaPlayback foreground service type is used only while an alarm is
          actually ringing.
        -->
        <service
            android:name=".alarm.AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false" />

        <activity
            android:name=".ui.AlarmRingActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:theme="@style/Theme.MorningAlarm.FullScreen"
            android:turnScreenOn="true" />

        <activity
            android:name=".ui.MorningSummaryActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SummaryEditorActivity"
            android:exported="false" />

        <!-- Explicit PendingIntent only; never exported. -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <!--
          Receives system events only. exported=false still allows protected system
          broadcasts such as BOOT_COMPLETED and TIME_SET.
        -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
          Hermes automation interface.

          Security model:
          * No intent-filter: only explicit component broadcasts are accepted.
          * Sender must hold android.permission.DUMP (signature|privileged|development).
            ADB shell and root normally hold it; ordinary third-party apps cannot.
          * Commands are parsed and validated; no arbitrary action or file access.
          * Only alarm CRUD/enable/disable is exposed.

          This is intentionally not callable by unprivileged apps. It has NOT been
          device-verified in this environment; see the handover notes.
        -->
        <receiver
            android:name=".hermes.HermesCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

    </application>

</manifest>
